{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "rootDir": "./src",
        "outDir": "./lib"
    },
    "include": ["src/**/*"],
    "exclude": [
        "src/**/*.test.*",
        "src/**/*-test.*",
        "src/**/*_test.*",
        "src/**/test-*.*",
        "src/**/test.*",
        "src/**/test/**/*"
    ]
}
